APP_NAME=AutoDoctor
APP_ENV=local
APP_KEY=
VIN_HASH_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=ru
APP_FALLBACK_LOCALE=ru
APP_FAKER_LOCALE=ru_RU

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12
HASH_DRIVER=argon

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=pgsql
# DB_HOST=127.0.0.1
# DB_PORT=5432
# DB_DATABASE=autodoctor
# DB_USERNAME=autodoctor
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# AI providers (secrets only in env — never commit real keys)
AI_ABACUS_API_KEY=
AI_ABACUS_BASE_URL=https://routellm.abacus.ai
AI_ABACUS_MODEL=route-llm

# Agent fuel wallet (abstract milliliters) + cost estimates for UI
AGENT_FUEL_STARTING_ML=5000
AGENT_FUEL_CAPACITY_ML=5000
AGENT_FUEL_ML_PER_1K_TOKENS=40
AGENT_FUEL_ML_PER_MESSAGE=80
AGENT_PRICE_CURRENCY=BYN
AGENT_COST_PER_1K_PROMPT=0.004
AGENT_COST_PER_1K_COMPLETION=0.012
AGENT_COST_PER_PROXY_MESSAGE=0.02
AI_DEEPSEEK_API_KEY=
AI_DEEPSEEK_BASE_URL=https://api.deepseek.com
AI_DEEPSEEK_MODEL=deepseek-chat
# Optional: custom CA bundle path (default: storage/certs/cacert.pem)
# AI_CA_BUNDLE=

# Google Sign-In (mobile id_token aud must match one of these)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_ANDROID_CLIENT_ID=
GOOGLE_IOS_CLIENT_ID=

# Telegram bot (never commit real values)
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=
# Comma-separated numeric user IDs. Empty + empty admin table = nobody is allowed.
TELEGRAM_ALLOWLIST_IDS=
# Who receives «Запросить доступ» DMs (your numeric Telegram ID)
TELEGRAM_OWNER_CHAT_ID=287536885
# HTTPS Mini App (defaults to APP_URL/telegram/app)
# TELEGRAM_MINI_APP_URL=https://api-dev.autodoctor.by/telegram/app
